# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
API_VERSION=v1
BASE_URL=http://your-server-ip-or-domain:8000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/CattleIdentification?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# ─── Email (Gmail SMTP via Nodemailer) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Cattle Identification System <noreply@cattleidentification.com>

# ─── SMS (2Factor.in OTP Gateway) ────────────────────────────────────────────
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png

# ─── Super Admin Defaults (used by setup-super-admin.js) ─────────────────────
SUPER_ADMIN_EMAIL=superadmin@cattleidentification.com
SUPER_ADMIN_DEFAULT_PASSWORD=SuperAdmin@123

# ─── Cattle Registration ──────────────────────────────────────────────────────
MIN_IMAGES_PER_CATEGORY=5
MAX_IMAGES_PER_CATEGORY=5
FULL_BODY_IMAGES=1
TOTAL_IMAGES_REQUIRED=12

# ─── Admin Verification Turnaround ────────────────────────────────────────────
VERIFICATION_TURNAROUND_HOURS=48

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-admin-web-domain.com

# ─── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── ML Model Server ──────────────────────────────────────────────────────────
# Leave empty to skip ML auto-processing (all requests go to M-Admin queue)
ML_SERVER_URL=
ML_TIMEOUT_MS=30000
